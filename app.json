{
  "expo": {
    "name": "iwent",
    "scheme": "iwent",
    "slug": "iwent",
    "version": "1.0.2",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-symbol.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0c"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.varyamalinina.iwent",
      "associatedDomains": [
        "applinks:iwent.ru",
        "applinks:www.iwent.ru"
      ],
      "buildNumber": "7",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "iwent.ru": {
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSIncludesSubdomains": true
            },
            "iventapp.ru": {
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSIncludesSubdomains": true
            }
          }
        },
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Приложение использует ваше местоположение, чтобы показывать события на карте рядом с вами. В фоновом режиме местоположение не используется."
      },
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/android-adaptive-foreground.png",
        "backgroundImage": "./assets/branding/android-adaptive-background.png",
        "monochromeImage": "./assets/branding/android-adaptive-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.varyamalinina.iwent",
      "versionCode": 1,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAqUq4AA5LhTHf0M_-z5GG3BOixuPszrd8"
        }
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "iWent needs access to your photos so you can add images to your events.",
          "cameraPermission": "iWent uses the camera so you can take photos for your events."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "iWent uses your location to show events on the map near you."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": false,
          "cameraPermission": "iWent uses the camera so you can take photos for your events."
        }
      ],
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "apiUrl": "https://iwent.ru",
      "YANDEX_MAPS_API_KEY": "e95f18c1-e796-4e6a-b2a9-0aafe5e420c4",
      "YANDEX_GEOCODER_API_KEY": "d84ff24e-0878-41ab-a83b-517487e2903a",
      "YANDEX_MAPKIT_API_KEY": "0b6f9cca-f83d-4b26-a837-7f0affdf242f"
    }
  }
}
