# Публичный URL вашего Nest API (без слэша в конце).
# Если API проксируется с того же домена, что и сайт:
VITE_API_BASE_URL=https://iwent.ru

# Основной веб (открывается через «Поделиться» / копирование ссылки)
VITE_MAIN_WEB_URL=https://iwent.ru

# ID сообщества ВК (положительное число, без минуса), от которого пользователь разрешит сообщения
VITE_VK_GROUP_ID=0

# Опционально: скриншот или баннер для витрины (прямой https URL, например из Object Storage)
# VITE_BRAND_HERO_URL=https://iwent.ru/storage/.../hero.webp

# Соцссылки на витрине (по умолчанию — канал и сообщество)
# VITE_TELEGRAM_URL=https://t.me/iwentapp
# VITE_VK_COMMUNITY_URL=https://vk.ru/club237398722
